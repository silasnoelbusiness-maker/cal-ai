# ---------------------------------------------------------------------------
# Converana environment variables
# Copy this file to .env.local (Next.js) and fill in real values.
# Never commit .env.local or any file containing real secrets.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL, used by Prisma) ---
# Supabase: Project Settings -> Database -> Connection string (URI, "Transaction" pooler
# recommended for serverless). Example:
# postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/converana"

# --- Supabase Auth ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key is server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Anthropic (AI qualification, summaries, replies) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Stripe (billing) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Price IDs created in the Stripe dashboard for each plan (see README).
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_GROWTH="price_..."
STRIPE_PRICE_PRO="price_..."

# --- Resend (transactional email) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Converana <notifications@yourdomain.com>"

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+15555555555"

# --- Converana internal ---
# Shared secret required in the Authorization header of /api/cron/follow-ups
LEADLOOP_API_SECRET="generate-a-long-random-string"

# Public URL of this deployment, used for embed snippets and email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: seeded demo/dev login (see prisma/seed.ts and README) ---
DEMO_USER_EMAIL="demo@converana.com"
DEMO_USER_PASSWORD="change-me-before-use"
