[resource]
script = ExtResource("1_business_type")
type_id = &"coffee_shop"
display_name = "Coffee Shop"
description = "Drinks made to order, sold at a counter."
required_roles = [1, 4]
minimum_shelf_units = 0
catalogue = [ExtResource("2_filter"), ExtResource("3_latte"), ExtResource("4_iced"), ExtResource("5_tea")]
supply_catalogue = [ExtResource("6_beans"), ExtResource("7_milk"), ExtResource("8_cup"), ExtResource("9_leaves")]
recipes = [ExtResource("10_r_filter"), ExtResource("11_r_latte"), ExtResource("12_r_iced"), ExtResource("13_r_tea")]
daily_utilities = 35
default_opening_hour = 7
default_closing_hour = 18
base_storage_capacity = 60
peak_customers_per_hour = 8.0
basket_range = Vector2i(1, 2)
